array[,,] int cluster_data_processing(array[,,] int clusters, array[] int counts) {
    int N = size(clusters);
    int P = size(clusters[1, 1, :]);

    array[N, P, P + 1] int indexes = rep_array(0, N, P, P + 1);
    int nbsta;
    
    for(i in 1:N) {
      for(icl in 1:counts[i]) {
          nbsta = 1;
          for(j in 1:P) {
              if(clusters[i, icl, j] == 1) {
                  indexes[i, icl, 1 + nbsta] = j;
                  nbsta += 1;
              }
          }
          indexes[i, icl, 1] = nbsta - 1;
      }
    }
    return indexes;
}
