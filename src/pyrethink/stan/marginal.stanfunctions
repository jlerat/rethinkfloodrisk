// -------------- GEV distribution ------------------------------
// tau Bounds when kappa > 0 : [ymax-alpha/kapp, +infty[
// tau Bounds when kappa < 0 : ]-infty, ycensor-alpha/kapp]

real gev_lpdf(real y, real tau, real alpha, real kappa){
    real logalpha = log(alpha);
    real u = (y - tau) / alpha;
    real v;

    // Threshold to transition from GEV to Gumbel
    real GEV2Gumbel_trans = 1e-10;

    real y0 = tau + alpha / kappa;
    if(kappa < -GEV2Gumbel_trans) {
        if(y < y0)
            reject("[gev_lpdf] y (", y, ") is lower than y0 (", y0, 
                   ") with tau=", tau, " alpha=", alpha, " kappa=", kappa);
    }
    else if (kappa > GEV2Gumbel_trans){
        if(y > y0)
            reject("[gev_lpdf] y (", y, ") is greater than y0 (", y0,
                   ") with tau=", tau, " alpha=", alpha, " kappa=", kappa);
    }
    
    if(abs(kappa) > GEV2Gumbel_trans) {
        // This is GEV log pdf
        v = -pow(1 - kappa * u, 1 / kappa);
        return -logalpha + v + (1 / kappa - 1) * log(1 - kappa * u);

    } else {
        // This Gumbel log pdf
        return -logalpha - u - exp(-u);
    }
}

real gev_cdf(real y, real tau, real alpha, real kappa){
    real u = (y - tau) / alpha;
    real v;
   
    // Threshold to transition from GEV to Gumbel
    real GEV2Gumbel_trans = 1e-10;

    real y0 = tau + alpha / kappa;
    if(kappa < -GEV2Gumbel_trans && y < y0) {
       reject("[gev_lcdf] y (", y, ") is lower than y0 (", y0, 
              ") with tau=", tau, " alpha=", alpha, " kappa=", kappa);
    }
    else if (kappa > GEV2Gumbel_trans && y > y0){
       reject("[gev_lcdf] y (", y, ") is greater than y0 (", y0,
              ") with tau=", tau, " alpha=", alpha, " kappa=", kappa);
    }
 
    if(abs(kappa) > GEV2Gumbel_trans) {
        return exp(-pow(1. - kappa * u, 1. / kappa));
    } else {
        return exp(-exp(-u));
    }
}

real gev_quantile(real p, real tau, real alpha, real kappa){
    //
    // p = exp(-pow(1. - kappa * u, 1. / kappa));
    // -log(p) = (1 - kappa * u)**(1/kappa)
    // (-log(p))**kappa = 1 - kappa * u
    // u = (1 - (-log(p))**kappa) / kappa
    // y = tau + alpha * (1 - (-log(p))**kappa) / kappa
    //
    // p = exp(-exp(-u))
    // -log(p) = exp(-u)
    // -log(-log(p)) = u
   
    // Threshold to transition from GEV to Gumbel
    real GEV2Gumbel_trans = 1e-10;

    if(p <= 0 || p >= 1) {
       reject("[gev_quantile] p (", p, ") is <=0 or >=1",
              " with tau=", tau, " alpha=", alpha, " kappa=", kappa);
    }

    if(abs(kappa) > GEV2Gumbel_trans) {
        return tau + alpha / kappa * (1 - pow(-log(p), kappa));
    } else {
        return tau - alpha * log(-log(p));
    }
}

